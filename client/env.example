# Sender Configuration
SENDER_TYPE=discord
SENDER_TIMEOUT_SECONDS=60

# Discord Configuration (if SENDER_TYPE=discord)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_COMMAND_GUILDS=123456789,987654321
DISCORD_ALLOWED_CHANNELS=123456789,987654321

# Webhook Configuration (if SENDER_TYPE=webhook)
WEBHOOK_LOGS_URL=https://discord.com/api/webhooks/...
WEBHOOK_PLAYERS_URL=https://discord.com/api/webhooks/...
WEBHOOK_WARN_URL=https://discord.com/api/webhooks/...

# Socket Configuration
SOCKET_TYPE=http
SOCKET_HOST=127.0.0.1
SOCKET_PORT=8080
SOCKET_TOKEN=generate_random_secure_token_here

# Translations (Optional)
TRANSLATION_LOADING=Loading...
TRANSLATION_DISCONNECTED=Server disconnected
TRANSLATION_CHANNEL_NOT_ALLOWED=Channel not allowed
TRANSLATION_ARGUMENT_NOT_SPECIFIED=Command argument not specified
